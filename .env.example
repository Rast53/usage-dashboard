# Copy to host / Dockhand stack env. Never commit real keys.
USAGE_PORT=3210
USAGE_POLL_SECONDS=60
USAGE_WINDOW_HOURS=24
USAGE_QUOTA_PROBE_SECONDS=300

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
ZAI_API_KEY=
# Direct docker egress to api.z.ai from tw-msk fails.
# HTTP CONNECT or SOCKS5/SOCKS5h. Userinfo is a secret (Dockhand is_secret) — never commit.
ZAI_PROXY=

# Command Code GOAT (Provider API key from Studio). Same key as /provider/v1.
# Live windows: GET https://api.commandcode.ai/alpha/billing/credits
COMMANDCODE_API_KEY=
# Optional HTTP CONNECT / SOCKS5(h) if tw-msk docker-egress to api.commandcode.ai fails.
COMMANDCODE_PROXY=

# OpenRouter from tw-msk: direct openrouter.ai is DPI-blocked.
# Default compose origin is London nginx reverse-proxy over Tailscale.
OPENROUTER_BASE_URL=https://100.69.177.71:8444
OPENROUTER_PROXY=
# 1 when BASE_URL is an HTTPS Tailscale IP (cert will not match the IP).
OPENROUTER_SSL_NO_VERIFY=1
# Alternative: OPENROUTER_BASE_URL=https://openrouter.ai
#              OPENROUTER_PROXY=socks5h://host.docker.internal:<socks-relay-port>
#              OPENROUTER_SSL_NO_VERIFY=0
