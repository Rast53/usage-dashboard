# Copy to host / Dockhand stack env. Never commit real keys.
USAGE_PORT=3210
USAGE_POLL_SECONDS=60
USAGE_WINDOW_HOURS=24
USAGE_QUOTA_PROBE_SECONDS=300

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
ZAI_API_KEY=
# Direct docker egress to api.z.ai from tw-msk fails.
# HTTP CONNECT or SOCKS5/SOCKS5h. Userinfo is a secret (Dockhand is_secret) — never commit.
ZAI_PROXY=

# Command Code GOAT (Provider API key from Studio). Same key as /provider/v1.
# Live windows: GET https://api.commandcode.ai/alpha/billing/credits
COMMANDCODE_API_KEY=
# Optional HTTP CONNECT / SOCKS5(h) if tw-msk docker-egress to api.commandcode.ai fails.
COMMANDCODE_PROXY=

# Kimi Coding / Kimi Code (Console API key). Same key as api.kimi.com/coding/v1.
# Live quota: GET https://api.kimi.com/coding/v1/usages
KIMI_API_KEY=
# Optional HTTP CONNECT / SOCKS5(h) if tw-msk docker-egress to api.kimi.com fails.
KIMI_PROXY=
# Override only for a compatible reverse-proxy origin (must still expose /usages).
# KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1

# OpenCode Go (same key as /zen/go/v1 chat). Live windows: GET /zen/go/v1/usage
OPENCODE_GO_API_KEY=
# Optional HTTP CONNECT / SOCKS5(h) if tw-msk docker-egress to opencode.ai fails.
OPENCODE_GO_PROXY=
# Override only for a compatible reverse-proxy origin (must still expose /usage).
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# Optional per-instance allowlist (comma-separated wallet keys).
# Empty / unset = all 6 (deepseek,openrouter,zai,commandcode,kimi,opencode-go).
# Second container (alan.ragpt.ru, ops after merge): PROVIDERS=opencode-go,openrouter
PROVIDERS=
# Page <title> / <h1>. Empty / unset = «Мои подписки».
# Second container: SITE_TITLE=Подписки — Алан
SITE_TITLE=

# OpenRouter from tw-msk: direct openrouter.ai is DPI-blocked.
# Default compose origin is London nginx reverse-proxy over Tailscale.
OPENROUTER_BASE_URL=https://100.69.177.71:8444
OPENROUTER_PROXY=
# 1 when BASE_URL is an HTTPS Tailscale IP (cert will not match the IP).
OPENROUTER_SSL_NO_VERIFY=1
# Alternative: OPENROUTER_BASE_URL=https://openrouter.ai
#              OPENROUTER_PROXY=socks5h://host.docker.internal:<socks-relay-port>
#              OPENROUTER_SSL_NO_VERIFY=0
# Alan instance only. Unset on the main stack (usage.ragpt.ru).
# 1 = GET /api/v1/key only; no /credits, /keys, /activity. Per-key spend, no account balance.
OPENROUTER_KEY_ONLY=
